<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vision preprocessing pipeline (replaces OpenCV):
         torchvision.transforms.Compose([
           Resize(84, 84),
           Grayscale(),
           Normalize(mean: [0.5], std: [0.5])
         ])
         Produces 84x84 grayscale tensors for the CNN branch.
         No OpenCV dependency needed — TorchSharp covers all transforms. -->
    <PackageReference Include="TorchSharp" Version="0.107.0" />
    <PackageReference Include="TorchSharp-cpu" Version="0.107.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PokemonRedRL.DAL\PokemonRedRL.DAL.csproj" />
  </ItemGroup>

</Project>

<Window x:Class="PokemonRedRL.ControlPanel.Views.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick emulator window" Height="300" Width="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Attach" Width="80" Margin="4" Click="OnAttachClick" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Margin="4" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="WindowList" DisplayMemberPath="Title"/>
    </DockPanel>
</Window>
